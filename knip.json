{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.test.{ts,tsx}",
    "src/**/*.test.{ts,tsx}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "services/**/*.{ts,tsx}",
    "store/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreFiles": [
    "components/DemoModeCallout.tsx",
    "components/ExpiredSignalBanner.tsx",
    "components/FeatureCards.tsx",
    "components/NavHeader.tsx",
    "components/NotificationBell.tsx",
    "components/NotificationPermissionButton.tsx",
    "components/PositionLimitToggle.tsx",
    "components/PricePrecisionToggle.tsx",
    "components/ProviderBadge.tsx",
    "components/RecommendationSettings.tsx",
    "components/RouteLoadingIndicator.tsx",
    "components/SecurityMetrics.tsx",
    "components/SignalEmptyState.tsx",
    "components/SignalFilterBottomSheet.tsx",
    "components/SignalRecommendations.tsx",
    "components/SignalSortControls.tsx",
    "components/StakeBadge.tsx",
    "components/SyncStatusIndicator.tsx",
    "components/TradeExecutionStatus.tsx",
    "components/TransactionFailure.tsx",
    "components/TransactionSuccess.tsx",
    "components/WebhookSettings.tsx",
    "components/signal/SignalFeed.tsx",
    "hooks/useNotificationPreference.ts",
    "hooks/usePageTransitionComplete.ts",
    "hooks/useSignalsFeed.ts",
    "hooks/useSubscriptions.ts",
    "hooks/useSyncStatus.ts",
    "hooks/useTradeExecution.ts",
    "lib/backtest.ts",
    "lib/mock-tx.ts",
    "lib/notifications.ts",
    "services/recommendationEngine.ts",
    "services/tradeExecutionService.ts",
    "services/webhookService.ts",
    "store/useRecommendationStore.ts",
    "store/useSignalStore.ts",
    "store/useWebhookStore.ts"
  ],
  "ignoreIssues": {
    "components/ui/button.tsx": ["exports", "types"],
    "components/ui/copy-button.tsx": ["types"],
    "lib/api.ts": ["types"],
    "lib/i18n.ts": ["exports"],
    "lib/signals.ts": ["types"],
    "lib/stellar.ts": ["exports"],
    "lib/toast.ts": ["exports"],
    "lib/types.ts": ["types"],
    "services/analytics.ts": ["types"],
    "src/tracing/worker-tracing.service.ts": ["types"],
    "store/usePortfolioStore.ts": ["types"],
    "store/usePricePrecisionStore.ts": ["types"],
    "store/useSignalFilterStore.ts": ["exports", "types"],
    "store/useTransactionStore.ts": ["types"]
  }
}
