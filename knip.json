{
  "$schema": "https://unpkg.com/knip@next/schema.json",
  "entry": ["app/**/page.tsx", "app/**/layout.tsx", "app/globals.css"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "services/**/*.{ts,tsx}",
    "store/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}"
  ],
  "ignore": ["components/ui/**", "**/*.test.{ts,tsx}", "**/__tests__/**"],

  "ignoreDependencies": [
    "eslint-config-next",
    "@testing-library/react",
    "jest-axe",
    "@types/jest-axe"
  ]
}
